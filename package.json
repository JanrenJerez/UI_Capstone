{
  "name": "project-e",
  "version": "1.0.0",
  "description": "Gym Attendance and POS System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.projecte.gym",
    "productName": "PROJECT - E",
    "files": [
      "main.js",
      "index.php",
      "forgotpass.php",
      "reset_pass.php",
      "logout.php",
      "member_profile.php",
      "uploads.php",
      "router.php",
      "forgot_pin.php",
      "lock.php",
      "admin/**/*",
      "pos/**/*",
      "includes/**/*",
      "assets/**/*",
      "database/**/*",
      "exports/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/php/",
        "to": "php",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/logo.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/logo.icns"
    },
    "directories": {
      "output": "dist"
    },
    "asar": false
  }
}
